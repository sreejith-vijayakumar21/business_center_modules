<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="business_center_booking_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">business.center.booking.cancel.wizard.view.form</field>
        <field name="model">business.center.booking.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Charge Decision">
                <div class="alert alert-warning" role="alert">
                    This booking has started (or was released, or nobody showed up).
                    Choose what the customer is charged and record why.
                </div>
                <group>
                    <group>
                        <field name="booking_ref"/>
                        <field name="booking_date"/>
                        <field name="booked_slot_display"/>
                    </group>
                    <group>
                        <field name="outcome" widget="radio"/>
                        <field name="used_until" widget="bc_time_select"
                               invisible="outcome != 'used'" required="outcome == 'used'"/>
                        <field name="billable_hours_display"/>
                    </group>
                </group>
                <field name="reason" placeholder="e.g. Customer called at 3:15 PM, stuck in traffic..."/>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Decision" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
