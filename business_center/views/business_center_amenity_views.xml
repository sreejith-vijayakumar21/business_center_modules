<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW -->
    <record id="business_center_amenity_view_form" model="ir.ui.view">
        <field name="name">business.center.amenity.view.form</field>
        <field name="model">business.center.amenity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="icon" widget="image" options="{'size': [24, 24]}" class="me-2"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="business_center_amenity_view_tree" model="ir.ui.view">
        <field name="name">business.center.amenity.view.tree</field>
        <field name="model">business.center.amenity</field>
        <field name="arch" type="xml">
            <list>
                <field name="icon" widget="image" options="{'size': [24, 24]}" class="me-2"/>
                <field name="name"/>
            </list>
        </field>
    </record>

        <!-- KANBAN VIEW -->
    <record id="business_center_amenity_view_kanban" model="ir.ui.view">
        <field name="name">business.center.amenity.view.kanaban</field>
        <field name="model">business.center.amenity</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center">
                            <field name="icon" widget="image" options="{'size': [24, 24]}"
                                class="me-2 flex-shrink-0" style="width:24px; height:24px; object-fit:contain;"/>
                            <span class="fw-medium text-truncate">
                                <field name="name"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_business_center_amenity" model="ir.actions.act_window">
        <field name="name">Business Center Amenity</field>
        <field name="res_model">business.center.amenity</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>