<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW -->
    <record id="business_center_contract_charge_view_form" model="ir.ui.view">
        <field name="name">business.center.contract.charge.view.form</field>
        <field name="model">business.center.contract.charge</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,invoiced,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="contract_id" placeholder="Owning Contract" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Charge Details">
                            <field name="description"/>
                            <field name="booking_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                        </group>

                        <group string="Pricing">
                            <field name="quantity" readonly="1"/>
                            <field name="unit_price" widget="monetary" readonly="1"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Invoicing">
                            <field name="invoice_line_id"/>
                        </group>

                        <group string="Company">
                            <field name="company_id" string="Company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="business_center_contract_charge_view_list" model="ir.ui.view">
        <field name="name">business.center.contract.charge.view.list</field>
        <field name="model">business.center.contract.charge</field>
        <field name="arch" type="xml">
            <list>
                <field name="contract_id"/>
                <field name="booking_id"/>
                <field name="invoice_line_id"/>
                <field name="date"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="amount"/>
                <field name="state" widget="badge"
                    decoration-warning="state == 'pending'"
                    decoration-success="state == 'invoiced'"
                    decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_business_center_contract_charge" model="ir.actions.act_window">
        <field name="name">Business Center Contract Charge</field>
        <field name="res_model">business.center.contract.charge</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>