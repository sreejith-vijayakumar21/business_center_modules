<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW -->
    <record id="business_center_booking_view_form" model="ir.ui.view">
        <field name="name">business.center.booking.view.form</field>
        <field name="model">business.center.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_decide_cancel_request" string="Decide Cancellation" type="object"
                            class="btn-primary" groups="business_center.group_bc_manager"
                            invisible="cancel_request_state != 'pending' or state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Booking Details">
                            <field name="contract_id"/>
                            <field name="center_id" readonly="1" invisible="not contract_id"/>
                            <field name="meeting_room_id" readonly="not contract_id"/>
                        </group>
                        <group string="Schedule">
                            <field name="booking_date"/>
                            <field name="operating_time"/>
                            <field name="slot_availability_html" widget="html" nolabel="1" colspan="2"
                               invisible="not meeting_room_id or not booking_date"/>
                            <field name="slot_open_hour" invisible="1"/>
                            <field name="slot_close_hour" invisible="1"/>
                            <field name="booked_ranges" invisible="1"/>
                            <field name="start_time" widget="bc_time_select"
                                   options="{'role': 'start', 'end_field': 'end_time',
                                             'open_field': 'slot_open_hour', 'close_field': 'slot_close_hour',
                                             'busy_field': 'booked_ranges'}"/>
                            <field name="end_time" widget="bc_time_select"
                                   options="{'role': 'end', 'start_field': 'start_time',
                                             'open_field': 'slot_open_hour', 'close_field': 'slot_close_hour',
                                             'busy_field': 'booked_ranges'}"/>
                            <field name="selected_slot_display" invisible="not start_time and not end_time"/>
                        </group>
                        <group string="Wallet &amp; Charges">
                            <field name="total_wallet_credits" string="Wallet Balance"/>
                            <field name="balance_wallet_credits" string="Balance After Booking (hrs)" invisible="total_wallet_credits == 0"/>
                            <field name="charge_per_hr"/>
                            <field name="chargeable_hours" invisible="1"/>
                            <field name="chargeable_hours_display"/>
                            <field name="overage_amount" string="Extra Charge"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="cancel_request_state" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="cancel_request_state != 'pending' or state != 'confirmed'">
                        The customer asked to cancel this booking. The room stays booked until a
                        manager answers with <strong>Decide Cancellation</strong>.
                    </div>
                    <group string="Cancellation Request" invisible="not cancel_request_state">
                        <group>
                            <field name="cancel_request_state"/>
                            <field name="cancel_requested_by_id"/>
                            <field name="cancel_requested_at"/>
                            <field name="cancelled_by_id" string="Answered By"
                                   invisible="cancel_request_state != 'rejected'"/>
                        </group>
                        <group>
                            <field name="cancel_request_reason"/>
                            <field name="cancel_reason" string="Answer"
                                   invisible="cancel_request_state != 'rejected'"/>
                        </group>
                    </group>
                    <group string="Cancellation" invisible="state != 'cancelled' or not cancel_outcome">
                        <group>
                            <field name="cancel_outcome"/>
                            <field name="cancelled_by_id"/>
                            <field name="original_end_time" widget="bc_time_select"
                                   invisible="cancel_outcome != 'used'"/>
                        </group>
                        <group>
                            <field name="cancel_reason" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="business_center_booking_view_tree" model="ir.ui.view">
        <field name="name">business.center.booking.view.tree</field>
        <field name="model">business.center.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="meeting_room_id"/>
                <field name="contract_id"/>
                <field name="center_id" optional="hide"/>
                <field name="booking_date"/>
                <field name="start_time" widget="bc_time_select"/>
                <field name="end_time" widget="bc_time_select"/>
                <field name="total_wallet_credits"/>
                <field name="balance_wallet_credits"/>
                <field name="chargeable_hours" invisible="1"/>
                <field name="chargeable_hours_display"/>
                <field name="overage_amount" string="Extra Charge"/>
                <field name="cancel_request_state" optional="show" widget="badge"
                       decoration-warning="cancel_request_state == 'pending'"
                       decoration-success="cancel_request_state == 'accepted'"
                       decoration-muted="cancel_request_state in ('rejected', 'withdrawn')"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'confirmed'"
                    decoration-warning="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="business_center_booking_view_search" model="ir.ui.view">
        <field name="name">business.center.booking.view.search</field>
        <field name="model">business.center.booking</field>
        <field name="arch" type="xml">
            <search string="Meeting Room Bookings">
                <field name="name"/>
                <field name="meeting_room_id"/>
                <field name="contract_id"/>
                <field name="user_id"/>
                <filter name="filter_today" string="Today"
                        domain="[('booking_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_cancel_requested" string="Cancellation Requested"
                        domain="[('cancel_request_state', '=', 'pending')]"/>
                <group>
                    <filter name="groupby_room" string="Meeting Room" context="{'group_by': 'meeting_room_id'}"/>
                    <filter name="groupby_date" string="Date" context="{'group_by': 'booking_date'}"/>
                    <filter name="groupby_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_business_center_booking" model="ir.actions.act_window">
        <field name="name">Business Center Booking</field>
        <field name="res_model">business.center.booking</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="business_center_booking_view_search"/>
    </record>

</odoo>