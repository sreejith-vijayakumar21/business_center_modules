<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.business.center</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Business Center" name="business_center"
                     logo="/business_center/static/description/icon.png">
                    <block title="Contracts" name="bc_contract_setting">
                        <setting string="Expiry Reminder Lead Days"
                                help="Days before a contract ends that the renewal reminder is sent. Individual contracts can override this.">
                            <field name="bc_expiry_reminder_days"/>
                        </setting>
                        <setting string="Post and Email Invoices Automatically"
                                help="Confirm each monthly contract invoice and email it to the tenant.">
                            <field name="bc_invoice_auto_send"/>
                        </setting>
                        <setting string="Default Renewal Rent Increase (%)"
                                help="Applied to the rent when a contract renews. Each contract can override it; use 0 to renew at the same rent.">
                            <field name="bc_renewal_increase_pct"/>
                        </setting>
                    </block>
                    <block title="Bookings" name="bc_booking_setting">
                        <setting string="Timezone"
                                help="Booking dates and times are compared in this timezone, including for portal users.">
                            <field name="bc_timezone" class="w-100"/>
                        </setting>
                        <setting string="Hot Desk Attendance"
                                help="When a hot desk booking starts and nobody checks in: remind the customer, then release the desk.">
                            <div class="mt-2">
                                Send a reminder after
                                <field name="bc_hot_desk_reminder_minutes" class="oe_inline"/> minutes,
                                release the desk after
                                <field name="bc_hot_desk_checkin_grace" class="oe_inline"/> minutes.
                            </div>
                        </setting>
                        <setting string="Hot Desk Charges"
                                help="What a booking released by the customer, or nobody showed up for, is charged.">
                            <div class="mt-2">
                                <div>Released by the customer: <field name="bc_hot_desk_late_release_charge" class="oe_inline"/></div>
                                <div>No-show: <field name="bc_hot_desk_no_show_charge" class="oe_inline"/></div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_business_center_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'business_center'}</field>
    </record>

</odoo>