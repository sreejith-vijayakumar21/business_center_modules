<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_business_center" model="ir.module.category">
        <field name="name">Business Center</field>
        <field name="description">Cabin space, coworking space, contract and booking management</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_business_center" model="res.groups.privilege">
        <field name="name">Business Center</field>
        <field name="category_id" ref="module_category_business_center"/>
        <field name="sequence">20</field>
    </record>

    <!-- Front desk / operations: bookings and draft contracts -->
    <record id="group_bc_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_business_center"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <!-- Internal staff: configuration, approvals, invoicing, past entries -->
    <record id="group_bc_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_business_center"/>
        <field name="implied_ids" eval="[Command.link(ref('group_bc_user')),
                                        Command.link(ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

</odoo>