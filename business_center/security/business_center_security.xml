<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company: a record is visible when it has no company or its
         company is ticked in the company switcher. Global rules (no groups),
         so they also narrow the portal tenant rules. -->

    <record id="rule_bc_contract_company" model="ir.rule">
        <field name="name">Contract: multi-company</field>
        <field name="model_id" ref="model_business_center_contract"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

