<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_bc_contract" model="ir.actions.report">
        <field name="name">Lease Agreement</field>
        <field name="model">business.center.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">business_center.report_bc_contract</field>
        <field name="report_file">business_center.report_bc_contract</field>
        <field name="print_report_name">'Lease Agreement - %s' % object.name.replace('/', '-')</field>
        <field name="binding_model_id" ref="model_business_center_contract"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_bc_contract_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
            <t t-set="monthly_total" t-value="sum(o.leased_asset_ids.mapped('monthly_rent_total'))"/>
            <t t-set="authorised" t-value="o.contact_ids - o.partner_id"/>

            <t t-set="address">
                <strong t-field="o.partner_id.name"/>
                <div t-field="o.partner_id"
                     t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                <div t-if="o.partner_id.vat">GSTIN: <span t-field="o.partner_id.vat"/></div>
            </t>

            <div class="page">
                <h2 class="mt-3">
                    <span t-if="o.state == 'draft'">Draft </span>Lease Agreement
                    <span t-field="o.name"/>
                </h2>

                <div class="row mt-3 mb-4" id="informations">
                    <div class="col-3" t-if="o.center_id">
                        <strong>Business Centre</strong>
                        <p class="m-0" t-field="o.center_id.name"/>
                    </div>
                    <div class="col-3">
                        <strong>Start Date</strong>
                        <p class="m-0" t-field="o.date_start"/>
                    </div>
                    <div class="col-3">
                        <strong>End Date</strong>
                        <p class="m-0" t-field="o.date_end"/>
                    </div>
                    <div class="col-3">
                        <strong>Term</strong>
                        <p class="m-0" t-out="o._get_term_display()"/>
                    </div>
                </div>

                <!-- 1. Parties -->
                <h5 class="mt-4 mb-2 pb-1 border-bottom">1. Parties</h5>
                <table class="table table-sm table-borderless">
                    <tr>
                        <td class="w-25"><strong>Lessor</strong></td>
                        <td>
                            <span t-field="o.company_id.name"/>
                            <span t-if="o.company_id.vat"> (GSTIN <span t-field="o.company_id.vat"/>)</span>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Lessee</strong></td>
                        <td>
                            <span t-field="o.partner_id.name"/>
                            <span t-if="o.partner_id.vat"> (GSTIN <span t-field="o.partner_id.vat"/>)</span>
                        </td>
                    </tr>
                    <tr t-if="authorised">
                        <td><strong>Authorised Occupants</strong></td>
                        <td t-out="', '.join(authorised.mapped('name'))"/>
                    </tr>
                </table>

                <!-- 2. Leased premises -->
                <h5 class="mt-4 mb-2 pb-1 border-bottom">2. Leased Premises</h5>
                <p t-if="o.center_id" class="mb-2">
                    <strong t-field="o.center_id.name"/>
                    <t t-set="center_address" t-value="o._get_center_address()"/>
                    <span t-if="center_address">, <t t-out="center_address"/></span>
                </p>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start">Type</th>
                            <th class="text-start">Space / Desk</th>
                            <th class="text-end">Monthly Rent</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.leased_asset_ids" t-as="asset">
                            <td><span t-field="asset.lease_asset_type"/></td>
                            <td><span t-out="(asset.space_id or asset.desk_id).display_name"/></td>
                            <td class="text-end"><span t-field="asset.monthly_rent_total"/></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="border-top">
                            <td colspan="2"><strong>Total Monthly Rent</strong></td>
                            <td class="text-end"><strong t-out="monthly_total" t-options="money"/></td>
                        </tr>
                    </tfoot>
                </table>

                <!-- 3. Financial terms -->
                <h5 class="mt-4 mb-2 pb-1 border-bottom">3. Financial Terms</h5>
                <table class="table table-sm table-borderless">
                    <tr>
                        <td class="w-50"><strong>Total Monthly Rent</strong></td>
                        <td class="text-end" t-out="monthly_total" t-options="money"/>
                    </tr>
                    <tr>
                        <td><strong>Security Deposit (refundable)</strong></td>
                        <td class="text-end" t-out="o.deposit_amount" t-options="money"/>
                    </tr>
                    <tr>
                        <td><strong>Auto Renewal</strong></td>
                        <td class="text-end">
                            <t t-if="o.auto_renew">
                                Yes, same term, rent revised by <t t-out="'%g' % o.renewal_increase_pct"/>%
                            </t>
                            <t t-else="">No</t>
                        </td>
                    </tr>
                </table>
                <ul class="small">
                    <li>Rent is invoiced monthly per calendar month. A partial first or last month is charged pro rata on the number of days occupied.</li>
                    <li>The security deposit is invoiced on confirmation, is not subject to GST, and is refunded after the agreement ends, less any deductions for damages or unpaid dues.</li>
                    <li t-if="o.is_wallet_eligible">Rent and meeting-room charges are subject to GST as applicable.</li>
                    <li t-else="">Rent is subject to GST as applicable.</li>
                </ul>

                <!-- 4. Meeting rooms: only contracts with an office get free hours and room access -->
                <h5 class="mt-4 mb-2 pb-1 border-bottom">4. Meeting Room Usage</h5>
                <t t-if="o.is_wallet_eligible">
                    <p>
                        The Lessee is entitled to
                        <strong><t t-out="'%g' % o.free_hours_monthly"/> hours</strong>
                        of meeting-room use free of charge each calendar month, shared across all
                        offices under this agreement. Unused hours do not carry forward. Usage
                        beyond the free allowance is charged at the hourly rates below and billed
                        on the next monthly invoice.
                    </p>
                    <t t-set="rooms" t-value="o._get_meeting_room_rates()"/>
                    <table t-if="rooms" class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th class="text-start">Meeting Room</th>
                                <th class="text-start">Available</th>
                                <th class="text-end">Rate per Hour</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="rooms" t-as="room">
                                <td t-out="room['name']"/>
                                <td t-out="room['hours']"/>
                                <td class="text-end" t-out="room['rate']" t-options="money"/>
                            </tr>
                        </tbody>
                    </table>
                    <p t-else="" class="small text-muted">
                        Meeting room rates are available from the centre on request.
                    </p>
                </t>
                <p t-else="">No meeting-room hours are included in this agreement.</p>

                <!-- 5. Terms & Conditions, exactly as entered on the contract -->
                <t t-if="not is_html_empty(o.note)">
                    <h5 class="mt-4 mb-2 pb-1 border-bottom">5. Terms &amp; Conditions</h5>
                    <div t-field="o.note"/>
                </t>

                <!-- Signatures -->
                <div class="row mt-5" style="page-break-inside: avoid;">
                    <div class="col-6">
                        <p class="mb-5"><strong>For <span t-field="o.company_id.name"/></strong></p>
                        <p class="mb-1">______________________________</p>
                        <p class="mb-1">Authorised Signatory</p>
                        <p>Date:</p>
                    </div>
                    <div class="col-6">
                        <p class="mb-3"><strong>For <span t-field="o.partner_id.name"/></strong></p>
                        <t t-if="o.agreement_state == 'signed'">
                            <img t-if="o.signature" t-att-src="image_data_uri(o.signature)"
                                 style="max-height: 4rem; max-width: 100%;"/>
                            <p class="mb-1 mt-2">Signed by <span t-field="o.signed_by"/></p>
                            <p>Date: <span t-field="o.signed_on"/></p>
                        </t>
                        <t t-else="">
                            <p class="mb-1 mt-5">______________________________</p>
                            <p class="mb-1">Authorised Signatory</p>
                            <p>Date:</p>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_bc_contract">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="business_center.report_bc_contract_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>