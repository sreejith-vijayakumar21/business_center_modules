<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_business_center_desk_booking" model="ir.sequence">
            <field name="name">Hot Desk Booking</field>
            <field name="code">business.center.desk.booking</field>
            <field name="prefix">HD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="product_hot_desk_booking" model="product.product">
            <field name="name">Hot Desk Booking</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
        </record>

        <record id="ir_cron_hot_desk_bookings" model="ir.cron">
            <field name="name">Business Center: hot desk no-shows and check-outs</field>
            <field name="model_id" ref="model_business_center_desk_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_hot_desk_bookings()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
