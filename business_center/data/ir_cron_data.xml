<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_activate_upcoming_contracts" model="ir.cron">
            <field name="name">Business Center: Activate Upcoming Contracts</field>
            <field name="model_id" ref="model_business_center_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_activate_upcoming_contracts()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 01:00:00')"/>
            <field name="priority">10</field>
            <field name="active" eval="True"/>
        </record>

