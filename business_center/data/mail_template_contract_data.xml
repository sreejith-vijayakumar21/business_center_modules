<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_contract_confirmation" model="mail.template">
            <field name="name">Business Center: Lease Agreement</field>
            <field name="model_id" ref="business_center.model_business_center_contract"/>
            <field name="subject">{{ object.company_id.name }} - Lease Agreement {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="report_template_ids" eval="[(4, ref('business_center.action_report_bc_contract'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="description">Sent to the tenant with the lease agreement PDF when a contract is confirmed</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_id.name or ''">Tenant</t>,
        <br/><br/>
        Thank you for choosing <t t-out="object.company_id.name or ''"/>.
        Please find attached your lease agreement <strong t-out="object.name or ''"/>
        for <t t-out="', '.join(object.leased_asset_ids.mapped('display_name'))"/>,
        running from <strong t-out="format_date(object.date_start) or ''"/>
        to <strong t-out="format_date(object.date_end) or ''"/>.
        <br/><br/>
        <t t-if="object.deposit_amount">
            The refundable security deposit of
            <strong t-out="format_amount(object.deposit_amount, object.currency_id) or ''"/>
            will be invoiced separately.
            <br/><br/>
        </t>
        Please review the agreement, sign it and send us a copy by replying to this email.
        Do not hesitate to contact us if you have any questions.
        <br/><br/>
        Kind regards,
        <t t-if="not is_html_empty(user.signature)">
            <br/><t t-out="user.signature or ''"/>
        </t>
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>