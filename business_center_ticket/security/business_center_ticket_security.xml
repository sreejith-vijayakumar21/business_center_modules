<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Staff: tickets of their own companies. -->
    <record id="rule_bc_ticket_company" model="ir.rule">
        <field name="name">Ticket: multi-company</field>
        <field name="model_id" ref="model_business_center_ticket"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!--
        Staff. Rules of different groups are OR'ed, and a manager is also a
        user, so the manager's rule wins: managers see every ticket. A user
        sees the tickets assigned to them, the unassigned ones (so nothing
        waits unseen), and any ticket they follow (a manager adds them as a
        follower to bring them in). The multi-company rule above, being
        global, still applies to both.
    -->
    <record id="rule_bc_ticket_user_own" model="ir.rule">
        <field name="name">Ticket: users see their own, unassigned and followed tickets</field>
        <field name="model_id" ref="model_business_center_ticket"/>
        <field name="domain_force">['|', '|',
            ('user_id', '=', user.id),
            ('user_id', '=', False),
            ('message_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('business_center.group_bc_user'))]"/>
    </record>

    <record id="rule_bc_ticket_manager_all" model="ir.rule">
        <field name="name">Ticket: managers see all tickets</field>
        <field name="model_id" ref="model_business_center_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('business_center.group_bc_manager'))]"/>
    </record>

    <!--
        Tenants: read only, so links in emails open the portal page. The
        portal pages themselves read with sudo() inside the same scope.
        Two rules on two groups are OR'ed: an employee sees the tickets they
        reported, a corporate admin sees the whole company's.
    -->
    <record id="rule_bc_ticket_tenant_employee" model="ir.rule">
        <field name="name">Ticket: employee sees own only</field>
        <field name="model_id" ref="model_business_center_ticket"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('business_center_portal.group_bc_tenant_employee'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_bc_ticket_tenant_admin" model="ir.rule">
        <field name="name">Ticket: corporate admin sees own company</field>
        <field name="model_id" ref="model_business_center_ticket"/>
        <field name="domain_force">[('commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('business_center_portal.group_bc_tenant_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
