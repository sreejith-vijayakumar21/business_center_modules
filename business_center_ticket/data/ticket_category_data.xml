<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ticket_category_internet" model="business.center.ticket.category">
            <field name="name">Internet &amp; Wi-Fi</field>
            <field name="sequence">10</field>
            <field name="description">Slow or no connection, Wi-Fi access, network points</field>
        </record>
        <record id="ticket_category_facilities" model="business.center.ticket.category">
            <field name="name">Facilities</field>
            <field name="sequence">20</field>
            <field name="description">Cleaning, air conditioning, lighting, pantry, access cards</field>
        </record>
        <record id="ticket_category_maintenance" model="business.center.ticket.category">
            <field name="name">Maintenance</field>
            <field name="sequence">30</field>
            <field name="description">Furniture, doors, plumbing, electrical or equipment repairs</field>
        </record>
        <record id="ticket_category_other" model="business.center.ticket.category">
            <field name="name">Other</field>
            <field name="sequence">99</field>
            <field name="description">Anything else: tell us what it is about</field>
            <field name="ask_topic" eval="True"/>
        </record>
    </data>
</odoo>
