<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Leased asset line: pick the office or desk on its floor plan. -->
    <record id="business_center_leased_asset_view_form_floor_picker" model="ir.ui.view">
        <field name="name">business.center.leased.asset.view.form.floor.picker</field>
        <field name="model">business.center.leased.asset</field>
        <field name="inherit_id" ref="business_center.business_center_leased_asset_view_form"/>
        <field name="arch" type="xml">
            <!-- The picker reads the line's own options and state. -->
            <field name="renewal_of_contract_id" position="after">
                <field name="contract_state" invisible="1"/>
                <field name="available_space_ids" invisible="1"/>
                <field name="available_desk_ids" invisible="1"/>
                <field name="contract_space_ids" invisible="1"/>
                <field name="contract_desk_ids" invisible="1"/>
            </field>
            <!-- First thing on the line: picking an office or a desk sets the
                 lease type and fills the space or desk. Hidden where the asset
                 cannot change (renewals, confirmed contracts). -->
            <field name="lease_asset_type" position="before">
                <widget name="bc_floor_picker" colspan="2"
                        invisible="renewal_of_contract_id or contract_state not in (False, 'draft')"
                        options="{'title': 'Pick an office or desk from the floor plan',
                                  'targets': {
                                      'bc_office': {'field': 'space_id', 'options_field': 'available_space_ids',
                                                    'values': {'lease_asset_type': 'office'}},
                                      'bc_desk': {'field': 'desk_id', 'options_field': 'available_desk_ids',
                                                  'values': {'lease_asset_type': 'desk'}}},
                                  'chosen_fields': {'bc_office': 'contract_space_ids', 'bc_desk': 'contract_desk_ids'}}"/>
            </field>
        </field>
    </record>

</odoo>