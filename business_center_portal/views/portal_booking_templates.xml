<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- HOME TILE -->
    <template id="portal_my_home_booking" name="Portal My Home: Bookings"
              inherit_id="portal.portal_my_home" priority="32">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-if="request.env.user.has_group('business_center_portal.group_bc_tenant_employee')">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                    <t t-set="title">Bookings</t>
                    <t t-set="text">View your active and past bookings</t>
                    <t t-set="url" t-value="'/my/bookings'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </t>
        </xpath>
    </template>

    <!-- LIST -->
    <template id="portal_my_bookings" name="My Bookings">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Bookings</t>
            </t>
            <div class="mb-3">
                <a href="/my/bookings/new" class="btn btn-primary btn-sm">
                    <i class="fa fa-plus me-1"/>New Booking
                </a>
            </div>

            <t t-if="not bookings">
                <div class="alert alert-warning" role="alert">
                    There are currently no bookings for your account.
                </div>
            </t>

            <t t-if="bookings" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Booking</th>
                        <th>Contract</th>
                        <th>Meeting Room</th>
                        <th>Employee</th>
                        <th class="text-end">Date</th>
                        <th class="text-end">Slot</th>
                        <th class="text-end">Extra Charge</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="bookings" t-as="booking">
                        <td>
                            <a t-attf-href="/my/bookings/#{booking.id}">
                                <span t-field="booking.name"/>
                            </a>
                        </td>
                        <td>
                            <a t-if="booking.contract_id" t-attf-href="/my/contracts/#{booking.contract_id.id}">
                                <span t-field="booking.contract_id.name"/>
                            </a>
                            <span t-else="" class="text-muted small">&#8212;</span>
                        </td>
                        <td><span t-field="booking.meeting_room_id"/></td>
                        <td>
                            <t t-if="booking.user_id">
                                <span class="o_bc_who">
                                    <img class="o_bc_avatar"
                                         t-attf-src="/web/image/res.users/#{booking.user_id.id}/avatar_128"
                                         t-att-alt="booking.user_id.name"
                                         t-att-title="booking.user_id.name"/>
                                    <span t-field="booking.user_id.name"/>
                                </span>
                            </t>
                            <span t-else="" class="text-muted small">&#8212;</span>
                        </td>
                        <td class="text-end"><span t-field="booking.booking_date"/></td>
                        <td class="text-end"><span t-field="booking.selected_slot_display"/></td>
                        <td class="text-end"><span t-field="booking.overage_amount"/></td>
                        <td class="text-center">
                            <span t-if="booking.state == 'confirmed'" class="badge rounded-pill text-bg-success">Confirmed</span>
                            <span t-elif="booking.state == 'draft'"   class="badge rounded-pill text-bg-info">Draft</span>
                            <span t-else=""                           class="badge rounded-pill text-bg-secondary">Cancelled</span>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <!-- DETAIL -->
    <template id="portal_booking_page" name="Booking Portal Page">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title"><span t-field="booking.name"/></t>

            <div class="row mt-4 mb-3">
                <div class="col-12 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <h5 class="mb-0">
                        Booking <span t-field="booking.name"/>
                        <span t-if="booking.state == 'confirmed'" class="badge text-bg-success">Confirmed</span>
                        <span t-elif="booking.state == 'draft'"   class="badge text-bg-info">Draft</span>
                        <span t-else=""                           class="badge text-bg-secondary">Cancelled</span>
                    </h5>
                    <button t-if="booking.state == 'confirmed'" type="button"
                            t-attf-class="btn btn-sm #{'btn-outline-danger' if can_cancel else 'btn-outline-secondary'}"
                            data-bs-toggle="modal" data-bs-target="#o_bc_cancel_booking">
                        <i class="fa fa-times me-1"/>Cancel booking
                    </button>
                </div>
            </div>
            <div t-if="error" class="alert alert-danger d-flex align-items-center" role="alert">
                <i class="fa fa-exclamation-circle me-2"/><t t-esc="error"/>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <h6 class="text-muted text-uppercase small">Booking Details</h6>
                    <div><strong>Meeting Room:</strong> <span t-field="booking.meeting_room_id"/></div>
                    <div t-if="booking.contract_id">
                        <strong>Contract:</strong>
                        <a t-attf-href="/my/contracts/#{booking.contract_id.id}">
                            <span t-field="booking.contract_id.name"/>
                        </a>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <h6 class="text-muted text-uppercase small">Schedule</h6>
                    <div><strong>Date:</strong> <span t-field="booking.booking_date"/></div>
                    <div><strong>Slot:</strong> <span t-field="booking.selected_slot_display"/></div>
                    <div t-if="booking.operating_time">
                        <strong>Room Hours:</strong> <span t-field="booking.operating_time"/>
                    </div>
                </div>
            </div>

            <h6 class="mt-3 text-muted text-uppercase small">Wallet &amp; Charges</h6>
            <table class="table table-sm">
                <tbody>
                    <tr>
                        <td>Wallet Balance (hrs)</td>
                        <td class="text-end"><span t-esc="booking._float_to_duration(booking.total_wallet_credits)"/></td>
                    </tr>
                    <tr>
                        <td>Balance After Booking (hrs)</td>
                        <td class="text-end"><span t-esc="booking._float_to_duration(booking.balance_wallet_credits)"/></td>
                    </tr>
                    <tr>
                        <td>Hourly Rate</td>
                        <td class="text-end">
                            <span t-if="booking.currency_id" t-field="booking.charge_per_hr"/>
                            <span t-else="" class="text-muted">-</span>
                        </td>
                    </tr>
                    <tr>
                        <td>Chargeable Hours</td>
                        <td class="text-end"><span t-esc="booking.chargeable_hours_display"/></td>
                    </tr>
                    <tr class="fw-bold">
                        <td>Extra Charge</td>
                        <td class="text-end">
                            <span t-if="booking.currency_id" t-field="booking.overage_amount"/>
                            <span t-else="" class="text-muted">-</span>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div t-if="booking.state == 'confirmed'" class="modal fade" id="o_bc_cancel_booking"
                 tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <t t-if="can_cancel">Cancel this booking?</t>
                                <t t-else="">This booking can't be cancelled</t>
                            </h5>
                            <button type="button" class="btn-close"
                                    data-bs-dismiss="modal" aria-label="Close"/>
                        </div>
                        <div class="modal-body">
                            <p class="mb-1">
                                <span t-field="booking.meeting_room_id"/> on
                                <span t-field="booking.booking_date"/>,
                                <span t-field="booking.selected_slot_display"/>.
                            </p>
                            <p t-if="can_cancel" class="text-muted small mb-0">
                                The slot is released and any wallet hours it used go back
                                to your contract's monthly credits.
                            </p>
                            <p t-else="" class="text-muted small mb-0" t-esc="cancel_block_reason"/>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                                <t t-if="can_cancel">Keep booking</t>
                                <t t-else="">Close</t>
                            </button>
                            <form t-if="can_cancel" method="post" class="d-inline"
                                  t-attf-action="/my/bookings/#{booking.id}/cancel">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-danger">
                                    <i class="fa fa-times me-1"/>Cancel booking
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- NO CONTRACT -->
    <template id="portal_booking_no_office" name="Booking: No Contract">
        <t t-call="portal.portal_layout">
            <div class="alert alert-info mt-4" role="alert">
                Meeting rooms can only be booked against a running contract.
                Please contact us to set one up.
            </div>
        </t>
    </template>

    <!-- CREATE FORM -->
    <template id="portal_booking_form" name="Book a Meeting Room">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Book a Meeting Room</t>

            <div class="o_bc_book">
                <div class="o_bc_book_head">
                    <h4>Book a Meeting Room</h4>
                    <a href="/my/bookings" class="o_bc_back">
                        <i class="fa fa-angle-left me-1"/>All bookings
                    </a>
                </div>

                <div t-if="error" class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="fa fa-exclamation-circle me-2"/><t t-esc="error"/>
                </div>

                    <form method="post" action="/my/bookings/new" id="o_bc_booking_form"
                      t-att-data-rate="room.hourly_rate">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- STEP 1 : WHERE -->
                    <section class="o_bc_card">
                        <div class="o_bc_step"><span class="o_bc_num">1</span>Where and when</div>
                        <div class="row g-3">
                            <div class="col-md-4" t-if="len(contracts) &gt; 1">
                                <label class="o_bc_label" for="contract_id">Contract</label>
                                <select name="contract_id" id="contract_id" class="form-select">
                                    <t t-foreach="contracts" t-as="opt">
                                        <option t-att-value="opt.id"
                                                t-att-selected="'selected' if opt == contract else None"
                                                t-esc="opt.name"/>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-4" t-else="">
                                <label class="o_bc_label">Contract</label>
                                <div class="form-control-plaintext" t-esc="contract.name"/>
                                <input type="hidden" name="contract_id" id="contract_id"
                                       t-att-value="contract.id"/>
                            </div>
                            <div class="col-md-4">
                                <label class="o_bc_label" for="meeting_room_id">Meeting room</label>
                                <select name="meeting_room_id" id="meeting_room_id" class="form-select">
                                    <t t-foreach="rooms" t-as="opt">
                                        <option t-att-value="opt.id"
                                                t-att-selected="'selected' if opt == room else None"
                                                t-esc="opt.display_name"/>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="o_bc_label" for="booking_date">Date</label>
                                <input type="date" name="booking_date" id="booking_date"
                                    class="form-control" t-att-value="booking_date"
                                    t-att-min="today"/>
                            </div>
                        </div>

                        <div class="o_bc_meta">
                            <div class="o_bc_chip">
                                <i class="fa fa-clock-o"/>
                                <span id="o_bc_hours" t-esc="room.operating_hours_display"/>
                            </div>
                            <div class="o_bc_chip">
                                <i class="fa fa-tag"/>
                                <span t-if="room.currency_id" t-field="room.hourly_rate"/>
                                <span t-else="">&#8212;</span>
                                <span class="o_bc_dim">/hr</span>
                            </div>
                            <div t-if="contract.is_wallet_eligible" class="o_bc_chip o_bc_chip_wallet">
                                <i class="fa fa-hourglass-half"/>
                                <span id="o_bc_wallet" t-esc="wallet"/>
                                <span class="o_bc_dim">of <t t-esc="free_hours"/> free hrs left</span>
                            </div>
                            <div t-else="" class="o_bc_chip o_bc_chip_wallet">
                                <i class="fa fa-hourglass-half"/>
                                <span id="o_bc_wallet" t-esc="wallet"/>
                                <span class="o_bc_dim">free hrs — all hours billed</span>
                            </div>
                        </div>
                    </section>

                    <!-- STEP 2 : AVAILABILITY -->
                    <section class="o_bc_card">
                        <div class="o_bc_step"><span class="o_bc_num">2</span>Pick a slot</div>
                        <div id="o_bc_slots" class="o_bc_slots" t-out="slots_html"/>
                        <div class="o_bc_legend">
                            <span><i class="o_bc_dot o_bc_dot_free"/>Available</span>
                            <span><i class="o_bc_dot o_bc_dot_busy"/>Booked</span>
                        </div>
                    </section>

                    <!-- STEP 3 : TIME -->
                    <section class="o_bc_card">
                        <div class="o_bc_step"><span class="o_bc_num">3</span>Confirm your time</div>
                        <div class="row g-3 align-items-end">
                            <div class="col-6 col-md-3">
                                <label class="o_bc_label" for="start_time">From</label>
                                <input type="time" name="start_time" id="start_time"
                                    class="form-control o_bc_time" required="required"/>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="o_bc_label" for="end_time">To</label>
                                <input type="time" name="end_time" id="end_time"
                                    class="form-control o_bc_time" required="required"/>
                            </div>
                            <div class="col-md-6">
                                <div id="o_bc_summary" class="o_bc_summary o_bc_summary_idle">
                                    Pick a start and end time to see the cost.
                                </div>
                            </div>
                        </div>
                    </section>

                    <div class="o_bc_actions">
                        <a href="/my/bookings" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fa fa-check me-1"/>Confirm booking
                        </button>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>