<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="business_center_member_request_view_form" model="ir.ui.view">
        <field name="name">business.center.member.request.form</field>
        <field name="model">business.center.member.request</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state != 'pending'" groups="business_center.group_bc_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'pending'" groups="business_center.group_bc_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="email"/>
                            <field name="role" readonly="state != 'pending'"/>
                        </group>
                        <group>
                            <field name="contract_id" readonly="1"/>
                            <field name="tenant_id"/>
                            <field name="requested_by_id" readonly="1"/>
                            <field name="decided_by_id" invisible="not decided_by_id"/>
                            <field name="decided_on" invisible="not decided_on"/>
                        </group>
                    </group>
                    <group invisible="state == 'approved'">
                        <field name="reject_reason" readonly="state == 'rejected'"
                               placeholder="e.g. The contract covers 5 people and all seats are taken."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="business_center_member_request_view_list" model="ir.ui.view">
        <field name="name">business.center.member.request.list</field>
        <field name="model">business.center.member.request</field>
        <field name="arch" type="xml">
            <list create="false" decoration-warning="state == 'pending'" decoration-muted="state == 'rejected'">
                <field name="create_date" string="Requested On"/>
                <field name="partner_id"/>
                <field name="tenant_id"/>
                <field name="contract_id"/>
                <field name="role"/>
                <field name="requested_by_id"/>
                <field name="state" widget="badge" decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="business_center_member_request_view_search" model="ir.ui.view">
        <field name="name">business.center.member.request.search</field>
        <field name="model">business.center.member.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="tenant_id"/>
                <filter name="filter_pending" string="Awaiting Approval" domain="[('state', '=', 'pending')]"/>
            </search>
        </field>
    </record>

    <record id="action_business_center_member_request" model="ir.actions.act_window">
        <field name="name">Team Requests</field>
        <field name="res_model">business.center.member.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No team requests</p>
            <p>When Approve New Team Members is on, members that tenants add from the portal wait here.</p>
        </field>
    </record>

    <menuitem id="menu_business_center_member_request" name="Team Requests"
              parent="business_center.business_center_menu_root"
              action="action_business_center_member_request"
              groups="business_center.group_bc_manager" sequence="18"/>

</odoo>