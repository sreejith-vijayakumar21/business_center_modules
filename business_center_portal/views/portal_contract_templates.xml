<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- HOME TILE -->
    <template id="portal_my_home_contract" name="Portal My Home: Contracts"
              inherit_id="portal.portal_my_home" priority="31">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-if="request.env.user.has_group('business_center_portal.group_bc_tenant_admin')">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                    <t t-set="title">Contracts</t>
                    <t t-set="text">Follow your business center contracts</t>
                    <t t-set="url" t-value="'/my/contracts'"/>
                    <t t-set="placeholder_count" t-value="'contract_count'"/>
                </t>
            </t>
        </xpath>
    </template>

    <!-- BADGES: shared by the contract cards and the contract page -->
    <template id="portal_contract_state_badge" name="Portal: Contract Status Badge">
        <span t-if="contract.state == 'upcoming'" class="badge rounded-pill text-bg-primary">Upcoming</span>
        <span t-elif="contract.state == 'active'" class="badge rounded-pill text-bg-success">Running</span>
        <span t-elif="contract.state == 'draft'" class="badge rounded-pill text-bg-info">Draft</span>
        <span t-elif="contract.state == 'expired'" class="badge rounded-pill text-bg-danger">Expired</span>
        <span t-else="" class="badge rounded-pill text-bg-secondary">Cancelled</span>
    </template>

    <template id="portal_contract_ending_badge" name="Portal: Contract Ending Badge">
        <span t-if="card['ending_soon']" class="badge rounded-pill text-bg-warning">
            <t t-if="card['days_left'] &gt; 0">Ends in <t t-out="card['days_left']"/> days</t>
            <t t-else="">Ends today</t>
        </span>
        <span t-elif="card['renewal']" class="badge rounded-pill text-bg-light border">
            <i class="fa fa-refresh me-1"/>Renewed as <t t-out="card['renewal'].name"/>
        </span>
    </template>

    <!-- LIST: one card per contract -->
    <template id="portal_my_contracts" name="My Contracts">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Contracts</t>
            </t>

            <div t-if="not contracts" class="alert alert-info mt-3" role="alert">
                No contracts match this filter.
                <a href="/my/contracts?filterby=all">Show all contracts</a>
            </div>

            <div t-if="contracts" class="row g-3 mt-1">
                <div t-foreach="contracts" t-as="contract" class="col-md-6">
                    <t t-set="card" t-value="cards[contract.id]"/>
                    <a t-attf-href="/my/contracts/#{contract.id}"
                       class="card h-100 text-reset text-decoration-none o_bc_contract_card">
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <h6 class="mb-0 me-auto" t-out="contract.name"/>
                                <t t-call="business_center_portal.portal_contract_ending_badge"/>
                                <t t-call="business_center_portal.portal_contract_state_badge"/>
                            </div>
                            <div t-if="contract.center_id" class="text-muted small mb-2">
                                <i class="fa fa-building-o me-1"/><t t-out="contract.center_id.name"/>
                            </div>
                            <div t-if="card['assets']" class="mb-2">
                                <span t-foreach="card['assets']" t-as="asset"
                                      class="badge rounded-pill text-bg-light border me-1" t-out="asset"/>
                            </div>
                            <div class="d-flex flex-wrap justify-content-between gap-2 small">
                                <div>
                                    <div class="text-muted">Period</div>
                                    <span t-field="contract.date_start"/> → <span t-field="contract.date_end"/>
                                    <i t-if="contract.auto_renew" class="fa fa-refresh text-success ms-1"
                                       title="Renews automatically" role="img" aria-label="Auto renew"/>
                                </div>
                                <div class="text-end">
                                    <div class="text-muted">Monthly rent</div>
                                    <strong t-out="card['monthly_rent']"
                                            t-options="{'widget': 'monetary', 'display_currency': contract.currency_id}"/>
                                </div>
                            </div>
                            <div t-if="contract.is_wallet_eligible" class="mt-3 small">
                                <div class="d-flex justify-content-between text-muted">
                                    <span>Free meeting-room hours</span>
                                    <span><t t-out="contract.wallet_balance"/> / <t t-out="contract.free_hours_monthly"/> hr</span>
                                </div>
                                <div class="progress mt-1" style="height: 6px;" role="progressbar"
                                     t-att-aria-valuenow="card['wallet_pct']" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-success" t-attf-style="width: #{card['wallet_pct']}%"/>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <div t-if="pager" class="o_portal_pager d-flex justify-content-center mt-3">
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>

    <!-- DETAIL -->
    <template id="portal_contract_page" name="Contract Portal Page">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title"><span t-field="contract.name"/></t>

            <!-- Header: title, status and downloads -->
            <div class="row mt-4 mb-3 align-items-center g-2">
                <div class="col">
                    <h5 class="mb-1">
                        Contract <span t-field="contract.name"/>
                        <t t-call="business_center_portal.portal_contract_state_badge"/>
                        <t t-call="business_center_portal.portal_contract_ending_badge"/>
                    </h5>
                    <div t-if="contract.agreement_state == 'signed'" class="text-muted small">
                        <i class="fa fa-check-circle text-success me-1" role="img" aria-label="Signed"/>
                        Signed by <span t-field="contract.signed_by"/> on <span t-field="contract.signed_on"/>
                    </div>
                    <div t-elif="contract.agreement_state == 'sent'" class="text-muted small">
                        <i class="fa fa-clock-o me-1" role="img" aria-label="Pending"/>
                        Awaiting your signature
                    </div>
                </div>
                <div class="col-12 col-md-auto d-flex flex-wrap gap-2">
                    <a t-if="contract.signed_attachment_id" class="btn btn-secondary"
                       t-attf-href="/my/contracts/#{contract.id}/signed-agreement"
                       title="View the signed copy you returned">
                        <i class="fa fa-file-pdf-o me-1"/>Signed Copy
                    </a>
                </div>
            </div>

            <!-- Tenant & Period -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <h6 class="text-muted text-uppercase small">Tenant &amp; Contacts</h6>
                    <div><strong>Partner:</strong> <span t-field="contract.partner_id"/></div>
                    <div t-if="contract.contact_ids">
                        <strong>Employees:</strong>
                        <t t-foreach="contract.contact_ids" t-as="emp">
                            <span class="badge text-bg-light border me-1" t-esc="emp.name"/>
                        </t>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <h6 class="text-muted text-uppercase small">Contract Period</h6>
                    <div><strong>Start:</strong> <span t-field="contract.date_start"/></div>
                    <div><strong>End:</strong> <span t-field="contract.date_end"/></div>
                    <div>
                        <strong>Auto Renew:</strong>
                        <i t-if="contract.auto_renew" class="fa fa-check text-success"/>
                        <i t-else="" class="fa fa-minus text-muted"/>
                    </div>
                </div>
            </div>
            <!-- Free-Hours Wallet: one shared allowance for the whole contract -->
            <div t-if="contract.is_wallet_eligible" class="row">
                <div class="col-12 mb-3">
                    <h6 class="text-muted text-uppercase small">Free-Hours Wallet</h6>
                    <div>
                        <strong>Monthly Allowance:</strong>
                        <span t-field="contract.free_hours_monthly"/> hr
                    </div>
                    <div>
                        <strong>Balance:</strong>
                        <span t-field="contract.wallet_balance"/> hr
                    </div>
                    <div class="text-muted small">
                        Shared across every office on this contract.
                    </div>
                </div>
            </div>

            <!-- Pending charges: contract-wide, so desk-only tenants see them too -->
            <div t-if="contract.pending_charge_total" class="row">
                <div class="col-12 mb-3">
                    <h6 class="text-muted text-uppercase small">Pending Charges</h6>
                    <div>
                        <strong>Not yet invoiced:</strong>
                        <span t-field="contract.pending_charge_total"/>
                    </div>
                </div>
            </div>

            <!-- Charges -->
            <t t-if="contract.charge_ids">
                <h6 class="mt-3 text-muted text-uppercase small">Charges</h6>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Date</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="contract.charge_ids" t-as="charge">
                            <td><span t-field="charge.description"/></td>
                            <td class="text-end"><span t-field="charge.date"/></td>
                            <td class="text-end"><span t-field="charge.quantity"/></td>
                            <td class="text-end"><span t-field="charge.unit_price"/></td>
                            <td class="text-end"><span t-field="charge.amount"/></td>
                            <td class="text-center">
                                <span t-if="charge.state == 'pending'"  class="badge text-bg-warning">Pending</span>
                                <span t-elif="charge.state == 'invoiced'" class="badge text-bg-success">Invoiced</span>
                                <span t-else="" class="badge text-bg-secondary">Cancelled</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>

            <!-- Terms & Conditions -->
            <t t-if="contract.note">
                <h6 class="mt-3 text-muted text-uppercase small">Terms &amp; Conditions</h6>
                <div class="border rounded p-3 bg-light" t-out="contract.note"/>
            </t>
        </t>
    </template>

    <!-- SIGNED COPY: shown like an invoice, details left, document right -->
    <template id="portal_contract_signed_page" name="Contract Signed Copy">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Signed Agreement</t>

            <div class="row mt-4">
                <!-- Details and actions -->
                <div class="col-lg-3 mb-4">
                    <div class="text-center mb-3">
                        <h5 class="mb-1">Contract <span t-field="contract.name"/></h5>
                        <div class="text-muted small">
                            <i class="fa fa-check-circle text-success me-1" role="img" aria-label="Signed"/>
                            Signed by <span t-field="contract.signed_by"/>
                            on <span t-field="contract.signed_on"/>
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a class="btn btn-primary" t-att-href="download_url">
                            <i class="fa fa-download me-1"/>Download
                        </a>
                        <a class="btn btn-light" t-att-href="contract_url">
                            <i class="fa fa-arrow-left me-1"/>Back to Contract
                        </a>
                    </div>
                </div>

                <!-- The signed document -->
                <div class="col-lg-9">
                    <iframe t-if="is_pdf" t-att-src="viewer_url"
                            class="w-100 border rounded shadow-sm" style="height: 85vh;"
                            title="Signed agreement"/>
                    <img t-elif="is_image" t-att-src="file_url"
                         class="img-fluid border rounded shadow-sm" alt="Signed agreement"/>
                    <div t-else="" class="alert alert-info">
                        This file cannot be previewed here. Use Download to open it.
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>