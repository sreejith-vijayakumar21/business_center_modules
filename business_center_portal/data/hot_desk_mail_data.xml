<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- "Still coming?" reminder with Keep / Release buttons. -->
        <record id="mail_template_hot_desk_reminder_portal" model="mail.template">
            <field name="name">Hot Desk: Still Coming? (with buttons)</field>
            <field name="model_id" ref="business_center.model_business_center_desk_booking"/>
            <field name="subject">Your hot desk {{ object.desk_id.name }} has started</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="body_html" type="html">
<div>
    <p>Dear <t t-out="object.partner_id.name"/>,</p>
    <p>Your hot desk booking <strong t-out="object.name"/> for
       <strong t-out="object.desk_id.name"/> started at
       <strong t-out="object.selected_slot_display"/>, and you have not checked in yet.
       Are you still coming?</p>
    <p style="margin: 24px 0;">
        <a t-att-href="object.get_base_url() + object.get_portal_url(suffix='/keep')"
           style="background:#6C7BF0;color:#fff;padding:10px 18px;border-radius:6px;text-decoration:none;margin-right:8px;">
            I'm on my way
        </a>
        <a t-att-href="object.get_base_url() + object.get_portal_url(suffix='/release')"
           style="background:#F1F2F6;color:#2E3142;padding:10px 18px;border-radius:6px;text-decoration:none;">
            Release the desk
        </a>
    </p>
    <p style="color:#858AA0;font-size:13px;">Releasing early lets someone else use the desk
       and may save you the no-show charge.</p>
    <p>Kind regards,<br/><t t-out="object.company_id.name"/></p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
