<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.business.center.community</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="business_center.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='business_center']" position="inside">
                <block title="Community Feed" name="bc_community_setting">
                    <setting string="Members Can Post"
                             help="Let members share updates and photos. Staff can always post.">
                        <field name="bc_community_member_posts"/>
                    </setting>
                    <setting string="Approve Member Posts First"
                             help="A member's post waits for staff approval before other members see it."
                             invisible="not bc_community_member_posts">
                        <field name="bc_community_moderation"/>
                    </setting>
                    <setting string="Community Moderator"
                             help="Reviews members' posts for business centres without a manager. Leave empty to use the first Business Center Manager."
                             invisible="not bc_community_member_posts or not bc_community_moderation">
                        <field name="bc_community_moderator_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
