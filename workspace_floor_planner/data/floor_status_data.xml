<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="status_available" model="workspace.floor.status">
            <field name="code">available</field>
            <field name="name">Available</field>
            <field name="description">No booking or contract blocks the unit.</field>
            <field name="color">#2E7D32</field>
            <field name="sequence">10</field>
        </record>
        <record id="status_occupied" model="workspace.floor.status">
            <field name="code">occupied</field>
            <field name="name">Occupied</field>
            <field name="description">The unit is currently in use.</field>
            <field name="color">#C62828</field>
            <field name="sequence">20</field>
        </record>
        <record id="status_reserved" model="workspace.floor.status">
            <field name="code">reserved</field>
            <field name="name">Reserved</field>
            <field name="description">A confirmed booking or contract blocks the unit.</field>
            <field name="color">#8E24AA</field>
            <field name="sequence">30</field>
        </record>
        <record id="status_maintenance" model="workspace.floor.status">
            <field name="code">maintenance</field>
            <field name="name">Maintenance</field>
            <field name="description">Temporarily out of service.</field>
            <field name="color">#F9A825</field>
            <field name="sequence">40</field>
        </record>
        <record id="status_partial" model="workspace.floor.status">
            <field name="code">partial</field>
            <field name="name">Partially available</field>
            <field name="description">A zone whose units have mixed statuses.</field>
            <field name="color">#1565C0</field>
            <field name="sequence">50</field>
        </record>
        <record id="status_draft" model="workspace.floor.status">
            <field name="code">draft</field>
            <field name="name">Draft</field>
            <field name="description">Linked to a record that is still being set up and is not ready to rent.</field>
            <field name="color">#D6DEE8</field>
            <field name="sequence">45</field>
        </record>
        <record id="status_not_linked" model="workspace.floor.status">
            <field name="code">not_linked</field>
            <field name="name">Not linked</field>
            <field name="description">Drawn on the plan, but no business record is linked to it yet.</field>
            <field name="color">#EEF0F4</field>
            <field name="sequence">55</field>
        </record>
        <record id="status_unknown" model="workspace.floor.status">
            <field name="code">unknown</field>
            <field name="name">Unknown</field>
            <field name="description">The status could not be determined, e.g. the record was removed or you cannot access it.</field>
            <field name="color">#B0BEC5</field>
            <field name="sequence">60</field>
        </record>
    </data>
</odoo>
