<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_floor_planner" model="res.groups.privilege">
        <field name="name">Floor Planner</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_floor_planner_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="comment">Can open floor plans and see unit statuses, but not change them.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_floor_planner"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_floor_planner_user" model="res.groups">
        <field name="name">Designer</field>
        <field name="comment">Can edit the layout of existing floor plans and link units.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_floor_planner"/>
        <field name="implied_ids" eval="[(4, ref('group_floor_planner_viewer'))]"/>
    </record>

    <record id="group_floor_planner_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Can create, archive and delete floor plans and configure palette and status colours.</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_floor_planner"/>
        <field name="implied_ids" eval="[(4, ref('group_floor_planner_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
