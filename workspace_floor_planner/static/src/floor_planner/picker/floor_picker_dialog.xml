<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="workspace_floor_planner.FloorPickerDialog">
        <Dialog title="props.title" size="'xl'" contentClass="'o_fp_picker'">
            <div class="o_fp_picker_body">

                <!-- Sidebar: site, then every floor with its vacancies -->
                <aside class="o_fp_picker_side">
                    <label t-if="props.sites.length > 1" class="o_fp_picker_side_label" for="o_fp_picker_site">
                        Site
                    </label>
                    <select t-if="props.sites.length > 1" id="o_fp_picker_site" class="form-select"
                            t-on-change="onSiteChange">
                        <option t-foreach="props.sites" t-as="site" t-key="site.id"
                                t-att-value="site.id" t-att-selected="site.id === state.siteId"
                                t-esc="site.name"/>
                    </select>
                    <div t-elif="site" class="o_fp_picker_site" t-esc="site.name"/>

                    <div class="o_fp_picker_side_label">Floors</div>
                    <div class="o_fp_picker_floor_list" role="tablist">
                        <button t-foreach="plans" t-as="plan" t-key="plan.key" type="button" role="tab"
                                class="o_fp_picker_floor"
                                t-att-class="{
                                    'active': plan.id and plan.id === state.planId,
                                    'o_fp_picker_floor_vacant': plan.pickable,
                                }"
                                t-att-aria-selected="plan.id and plan.id === state.planId"
                                t-att-disabled="!plan.id"
                                t-on-click="() => this.onPlanClick(plan.id)">
                            <span class="o_fp_picker_floor_name" t-esc="plan.name"/>
                            <span t-if="!plan.id" class="o_fp_picker_floor_info">No layout</span>
                            <span t-elif="plan.pickable" class="o_fp_picker_floor_count">
                                <t t-esc="plan.pickable"/> available
                            </span>
                            <span t-else="" class="o_fp_picker_floor_info">No vacancy</span>
                        </button>
                    </div>

                    <p t-if="site and site.note" class="o_fp_picker_note">
                        <i class="fa fa-info-circle me-1"/><t t-esc="site.note"/>
                    </p>
                </aside>

                <!-- Floor plan of the selected floor -->
                <div class="o_fp_picker_canvas" t-ref="canvasArea">
                    <!-- Zoom controls -->
                    <div t-if="state.store" class="o_fp_picker_zoom" role="group" aria-label="Zoom">
                        <button type="button" class="btn btn-light btn-sm" title="Zoom out"
                                t-on-click="zoomOut">
                            <i class="fa fa-search-minus"/>
                        </button>
                        <span class="o_fp_picker_zoom_value"><t t-esc="zoomPercent"/>%</span>
                        <button type="button" class="btn btn-light btn-sm" title="Zoom in"
                                t-on-click="zoomIn">
                            <i class="fa fa-search-plus"/>
                        </button>
                        <button type="button" class="btn btn-light btn-sm" title="Fit the whole floor"
                                t-on-click="fit">
                            <i class="fa fa-expand"/>
                        </button>
                    </div>
                    <FloorCanvas t-if="state.store" t-key="state.planId" store="state.store"
                                 readonly="true" onReady.bind="onCanvasReady"/>
                    <div t-elif="!state.loading" class="o_fp_picker_empty">
                        No floor of this site has a layout yet. Use the dropdown instead.
                    </div>
                </div>
                <!-- Details of the clicked unit -->
                <FloorUnitDetails details="state.details" loading="state.detailsLoading"
                                  selected="!!selected" status="selectedStatus"/>
            </div>

            <t t-set-slot="footer">
                <div class="o_fp_picker_selection me-auto text-muted">
                    <t t-if="!selected">Click a green unit on the plan.</t>
                    <t t-elif="isChosen(selected)">Already on this contract.</t>
                    <t t-elif="!selectedPickable">Not available for this record.</t>
                    <t t-else="">Ready to select.</t>
                </div>
                <button type="button" class="btn btn-primary" t-att-disabled="!selectedPickable"
                        t-on-click="confirm">
                    Select
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
    <t t-name="workspace_floor_planner.FloorUnitDetails">
        <aside class="o_fp_details" aria-live="polite">
            <div t-if="props.loading" class="o_fp_details_empty">
                <i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/>
                <span class="visually-hidden">Loading</span>
            </div>
            <t t-elif="props.details">
                <!-- On its own so a click can later open the full gallery. -->
                <div class="o_fp_details_media">
                    <img t-if="props.details.image_url" class="o_fp_details_photo"
                         t-att-src="props.details.image_url" t-att-alt="props.details.title"/>
                    <div t-else="" class="o_fp_details_photo_empty">
                        <i class="fa fa-picture-o" aria-hidden="true"/>
                    </div>
                </div>

                <div class="o_fp_details_head">
                    <div class="o_fp_details_subtitle" t-esc="props.details.subtitle"/>
                    <div class="o_fp_details_title" t-esc="props.details.title"/>
                    <span t-if="props.status" class="o_fp_details_status"
                          t-attf-class="o_fp_details_status_{{ props.status.tone }}"
                          t-esc="props.status.label"/>
                </div>

                <dl t-if="props.details.facts.length" class="o_fp_details_facts">
                    <t t-foreach="props.details.facts" t-as="fact" t-key="fact_index">
                        <dt t-esc="fact.label"/>
                        <dd t-esc="fact.value"/>
                    </t>
                </dl>

                <section t-foreach="props.details.sections" t-as="section" t-key="section_index"
                         class="o_fp_details_block">
                    <div class="o_fp_details_label" t-esc="section.title"/>
                    <dl t-if="section.facts and section.facts.length" class="o_fp_details_facts">
                        <t t-foreach="section.facts" t-as="fact" t-key="fact_index">
                            <dt t-esc="fact.label"/>
                            <dd t-esc="fact.value"/>
                        </t>
                    </dl>
                    <div t-if="section.tags and section.tags.length" class="o_fp_details_tags">
                        <span t-foreach="section.tags" t-as="tag" t-key="tag_index"
                              class="o_fp_details_tag" t-esc="tag"/>
                    </div>
                </section>
            </t>
            <div t-elif="props.selected" class="o_fp_details_empty">
                No details for this unit.
            </div>
            <div t-else="" class="o_fp_details_empty">
                Click a unit on the plan to see its details.
            </div>
        </aside>
    </t>

</templates>
