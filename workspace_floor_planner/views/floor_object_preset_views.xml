<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workspace_floor_object_preset_view_list" model="ir.ui.view">
        <field name="name">workspace.floor.object.preset.list</field>
        <field name="model">workspace.floor.object.preset</field>
        <field name="arch" type="xml">
            <list string="Palette Presets" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="object_type"/>
                <field name="width"/>
                <field name="height"/>
                <field name="fill_color" widget="color"/>
                <field name="border_color" widget="color"/>
                <field name="border_width" optional="hide"/>
                <field name="text_color" widget="color" optional="hide"/>
                <field name="font_size" optional="hide"/>
                <field name="icon" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_workspace_floor_object_preset" model="ir.actions.act_window">
        <field name="name">Palette Presets</field>
        <field name="res_model">workspace.floor.object.preset</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
